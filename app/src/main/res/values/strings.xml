    <!-- Background Keep-Alive -->
    <string name="routing_bg_persistence_title">Background EQ Keep-Alive</string>
    <string name="routing_bg_persistence_subtitle_on">Keep DSP alive &amp; switch device rules even if app is killed</string>
    <string name="routing_bg_persistence_subtitle_off">Standard lifecycle (EQ stops if OS kills the app process)</string>
    <string name="routing_bg_persistence_desc_on">Shizuku DSP stays alive in daemon mode, autonomously monitors output device changes to apply per-device presets or Auto EQ OFF even while Quve is killed, and auto-recovers without audio dropout. Toggling while active briefly reconnects the engine.</string>
